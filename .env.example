# Placeholders for docker-compose.yml. Copy to `.env` and adjust locally;
# `.env` is git-ignored and never committed. CI sets its own throwaway
# values (.github/workflows/ci.yml) and does not read this file.
#
# No real secrets belong here or in `.env` for this compose topology — it
# only ever runs against local, disposable data (CLAUDE.md).

POSTGRES_USER=earthx
POSTGRES_PASSWORD=changeme
POSTGRES_DB=earthx

# Object store (Garage, M3-23/adr/0012). Leave empty: the objectstore-secrets
# service generates a key and bucket on the first `docker compose up` and
# reuses them on every later start. Set all three only to pin your own
# values (S3_ACCESS_KEY at least 8 characters, S3_SECRET_KEY at least 16).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Place search (Nominatim, M3-07a). Empty by default: place search stays off
# until you set this, the safe end of the range. Set it to enable it locally:
#   EARTHX_GEOCODER_URL=https://nominatim.openstreetmap.org
# That is the public service's usage policy
# (https://operations.osmfoundation.org/policies/nominatim/): at most one
# request per second summed over every process, a proper User-Agent (below),
# no autocomplete, and the OpenStreetMap/ODbL attribution the API answers
# with must reach whoever sees the result. It can be withdrawn or changed
# without notice — never point this at a paid or otherwise privileged
# account without checking the policy again. Never a query string of its own.
EARTHX_GEOCODER_URL=
# Optional: override the default User-Agent this process identifies itself
# with to the geocoder (the policy above requires one that is not a plain
# HTTP library default). Leave empty to use the built-in one.
EARTHX_GEOCODER_USER_AGENT=
