; Module boundaries from architekturplan.md 3.1, as import-linter contracts.
;
; STATUS: ENFORCED (M1-02). The target modules under `backend/earthx/` exist
; as empty packages; the `import-boundaries` job in .github/workflows/ci.yml
; runs `lint-imports` on every pull request.
;
; Each contract names what a module may NOT import. The allowed imports are the
; complement, i.e. exactly column 3 of the table in architekturplan.md 3.1.
; `backend/tests/test_module_boundaries.py` checks that this file stays in sync
; with that table.
;
; Run locally from the repo root: PYTHONPATH=backend lint-imports --config .importlinter

[importlinter]
root_package = earthx
include_external_packages = True

[importlinter:contract:gateway]
name = gateway imports nothing domain-specific
type = forbidden
source_modules =
    earthx.gateway
forbidden_modules =
    earthx.catalog
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets

[importlinter:contract:catalog]
name = catalog imports only gateway
type = forbidden
source_modules =
    earthx.catalog
forbidden_modules =
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets

[importlinter:contract:adapters]
name = adapters import only gateway and catalog
type = forbidden
source_modules =
    earthx.adapters
forbidden_modules =
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets

[importlinter:contract:readers]
name = readers import only gateway
type = forbidden
source_modules =
    earthx.readers
forbidden_modules =
    earthx.catalog
    earthx.adapters
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets

[importlinter:contract:access]
name = access imports only readers and catalog
type = forbidden
source_modules =
    earthx.access
forbidden_modules =
    earthx.gateway
    earthx.adapters
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets

[importlinter:contract:processing]
name = processing imports only access, readers and catalog
type = forbidden
source_modules =
    earthx.processing
forbidden_modules =
    earthx.gateway
    earthx.adapters
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets

[importlinter:contract:jobs]
name = jobs import only processing
type = forbidden
source_modules =
    earthx.jobs
forbidden_modules =
    earthx.gateway
    earthx.catalog
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets

[importlinter:contract:discovery]
name = discovery imports only adapters, catalog and gateway
type = forbidden
source_modules =
    earthx.discovery
forbidden_modules =
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.identity
    earthx.api
    earthx.datasets

[importlinter:contract:identity]
name = identity imports nothing else
type = forbidden
source_modules =
    earthx.identity
forbidden_modules =
    earthx.gateway
    earthx.catalog
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.api
    earthx.datasets

[importlinter:contract:datasets-isolated]
name = nothing generic imports a dataset module
type = forbidden
source_modules =
    earthx.gateway
    earthx.catalog
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
forbidden_modules =
    earthx.datasets

[importlinter:contract:no-database-in-worker-core]
name = the worker core reaches no database (KLAERUNGEN B9)
type = forbidden
source_modules =
    earthx.jobs
    earthx.processing
forbidden_modules =
    psycopg

[importlinter:contract:http-only-in-gateway]
name = HTTP and S3 clients live only in gateway (KLAERUNGEN B8)
type = forbidden
; Source modules are the ten of 3.1 that are not `gateway`, PLUS every module
; that lives directly in the package root. A root module is not one of the
; eleven, but it is still code that must not fetch — `test_module_boundaries.py`
; reads the root modules from disk, so a new one fails the suite until it is
; listed here.
source_modules =
    earthx.logging
    earthx.catalog
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets
forbidden_modules =
    httpx
    requests
    urllib
    pystac_client
    aiohttp
    boto3
