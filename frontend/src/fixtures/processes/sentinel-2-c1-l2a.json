{
  "description": "Computes a recipe — datasets, items, assets, an area of interest, steps and an output — into a Cloud Optimized GeoTIFF. Asynchronous only. It follows the form of OGC API – Processes, no conformance claimed.",
  "id": "recipe",
  "inputs": {
    "aoiProvenance": {
      "description": "For an order with an area (aoi) only: where a place-search AOI came from, written into ATTRIBUTION.txt and aoi.geojson of the export or of the ZIP of the job. Not part of the recipe, its hash or the cache. Each field is one line of plain text: no leading or trailing space, no control or format characters.",
      "maxOccurs": 1,
      "minOccurs": 0,
      "schema": {
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "attribution": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "license": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "title": "Origin of the area of interest"
    },
    "recipe": {
      "description": "The order itself, inline. It carries no address: the platform resolves items and assets. An input given by reference is refused.",
      "maxOccurs": 1,
      "minOccurs": 1,
      "schema": {
        "$defs": {
          "InputRequest": {
            "additionalProperties": false,
            "description": "One input of an order: a dataset, its items in groups, and the asset keys to read.",
            "properties": {
              "assets": {
                "description": "Recipe version 1 only. Version 2 names the bands in output.bands, and the platform reads the assets they need.",
                "items": {
                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "title": "Assets",
                "type": "array"
              },
              "dataset": {
                "const": "sentinel-2-c1-l2a",
                "title": "Dataset"
              },
              "groups": {
                "items": {
                  "items": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "minItems": 1,
                "title": "Groups",
                "type": "array"
              },
              "name": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "title": "Name",
                "type": "string"
              }
            },
            "required": [
              "name",
              "dataset",
              "groups"
            ],
            "title": "InputRequest",
            "type": "object"
          },
          "MultiPolygon": {
            "additionalProperties": false,
            "properties": {
              "coordinates": {
                "items": {
                  "items": {
                    "items": {
                      "maxItems": 2,
                      "minItems": 2,
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "type": "array"
                    },
                    "type": "array"
                  },
                  "type": "array"
                },
                "minItems": 1,
                "title": "Coordinates",
                "type": "array"
              },
              "type": {
                "const": "MultiPolygon",
                "title": "Type",
                "type": "string"
              }
            },
            "required": [
              "type",
              "coordinates"
            ],
            "title": "MultiPolygon",
            "type": "object"
          },
          "Polygon": {
            "additionalProperties": false,
            "properties": {
              "coordinates": {
                "items": {
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "type": "array"
                },
                "minItems": 1,
                "title": "Coordinates",
                "type": "array"
              },
              "type": {
                "const": "Polygon",
                "title": "Type",
                "type": "string"
              }
            },
            "required": [
              "type",
              "coordinates"
            ],
            "title": "Polygon",
            "type": "object"
          },
          "RasterOutput": {
            "additionalProperties": false,
            "description": "A job's result: one COG, with the bands ``bands`` names, in this order (adr/0020 §5).",
            "properties": {
              "bands": {
                "description": "The bands the result holds, in this order: bands of the data and bands the steps add. Each once, case ignored; each has to be in the stock after the last step.",
                "items": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                  "type": "string"
                },
                "minItems": 1,
                "title": "Bands",
                "type": "array"
              },
              "dtype": {
                "enum": [
                  "uint8",
                  "uint16",
                  "int16",
                  "uint32",
                  "int32",
                  "float32",
                  "float64"
                ],
                "title": "Dtype",
                "type": "string"
              },
              "format": {
                "const": "cog",
                "title": "Format",
                "type": "string"
              },
              "kind": {
                "const": "raster",
                "title": "Kind",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "format",
              "dtype",
              "bands"
            ],
            "title": "RasterOutput",
            "type": "object"
          },
          "step_band_math_v2": {
            "additionalProperties": false,
            "description": "Compute a band from an expression over the bands, in physical values, and add it to the bands.",
            "properties": {
              "op": {
                "const": "band_math"
              },
              "op_version": {
                "const": 2
              },
              "params": {
                "additionalProperties": false,
                "description": "Version 2: the expression and the name of the band it adds, always given (B10).",
                "properties": {
                  "expression": {
                    "description": "Band names, numbers, + - * / **, comparisons, & | ~ on comparisons, and where(c, a, b), abs, minimum, maximum, sqrt. Evaluated on physical values.",
                    "maxLength": 256,
                    "minLength": 1,
                    "title": "Expression",
                    "type": "string"
                  },
                  "name": {
                    "description": "Name of the new band, such as NDVI: a letter, then letters, digits or _. It is free in the data and in the other results (case ignored); later steps and the output name the band by it.",
                    "maxLength": 32,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                  }
                },
                "required": [
                  "expression",
                  "name"
                ],
                "title": "BandMathParamsV2",
                "type": "object"
              }
            },
            "required": [
              "op",
              "op_version",
              "params"
            ],
            "title": "Band math",
            "type": "object",
            "x-earthx-kind": "pixel",
            "x-earthx-tiers": [
              "T1",
              "T2"
            ]
          },
          "step_mask_v2": {
            "additionalProperties": false,
            "description": "Hide the pixels that a classification layer assigns to the chosen classes, such as cloud.",
            "properties": {
              "op": {
                "const": "mask"
              },
              "op_version": {
                "const": 2
              },
              "params": {
                "additionalProperties": false,
                "description": "The panel's form (K8): the layer's band name and the classes to hide, both always given (B10).",
                "properties": {
                  "classes": {
                    "description": "Class values to hide, ascending and each once.",
                    "items": {
                      "maximum": 65535,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "maxItems": 64,
                    "minItems": 1,
                    "title": "Classes",
                    "type": "array"
                  },
                  "source": {
                    "description": "Band name of the classification layer, as the registry names it.",
                    "maxLength": 64,
                    "minLength": 1,
                    "title": "Source",
                    "type": "string"
                  }
                },
                "required": [
                  "source",
                  "classes"
                ],
                "title": "MaskParams",
                "type": "object"
              }
            },
            "required": [
              "op",
              "op_version",
              "params"
            ],
            "title": "Mask by class",
            "type": "object",
            "x-earthx-kind": "pixel",
            "x-earthx-tiers": [
              "T1",
              "T2"
            ]
          },
          "step_mask_values_v1": {
            "additionalProperties": false,
            "description": "Hide the pixels where a band is below, above, between or equal to the values given.",
            "properties": {
              "op": {
                "const": "mask_values"
              },
              "op_version": {
                "const": 1
              },
              "params": {
                "additionalProperties": false,
                "description": "The panel's form (K8): the band to look at, the condition and its numbers, all always given (B10).",
                "properties": {
                  "band": {
                    "description": "Name of the band whose values decide: a band of the data or the result of an earlier step.",
                    "maxLength": 64,
                    "minLength": 1,
                    "title": "Band",
                    "type": "string"
                  },
                  "condition": {
                    "description": "lt: hide where the band is below the value. gt: above the value. between: from the first value to the second, both included. eq: equal to one of the values.",
                    "enum": [
                      "lt",
                      "gt",
                      "between",
                      "eq"
                    ],
                    "title": "Condition",
                    "type": "string"
                  },
                  "values": {
                    "description": "The numbers of the condition, in physical values: one for lt and gt, two for between (low, high), one to 64 for eq (ascending, each once). Compared in the data type of the band.",
                    "items": {
                      "maximum": 3.4028234663852886e+38,
                      "minimum": -3.4028234663852886e+38,
                      "type": "number"
                    },
                    "maxItems": 64,
                    "minItems": 1,
                    "title": "Values",
                    "type": "array"
                  }
                },
                "required": [
                  "band",
                  "condition",
                  "values"
                ],
                "title": "MaskValuesParams",
                "type": "object"
              }
            },
            "required": [
              "op",
              "op_version",
              "params"
            ],
            "title": "Mask by value",
            "type": "object",
            "x-earthx-kind": "pixel",
            "x-earthx-tiers": [
              "T1",
              "T2"
            ]
          },
          "step_normalize_v4": {
            "additionalProperties": false,
            "description": "Rescale the values of the bands named: a fixed range, two percentiles, a z-score, or the median and the interquartile range.",
            "properties": {
              "op": {
                "const": "normalize"
              },
              "op_version": {
                "const": 4
              },
              "params": {
                "additionalProperties": false,
                "description": "The step of version 4: ``method``, the ``bands`` it converts, and the fields of that method, all given (B10).\n\nOne model for all four methods; the fields of the others stay out (:meth:`_method`), so a recipe says exactly\nwhat its method needs.\n\nThe numbers of ``percentile``, ``zscore`` and ``robust`` are measured in the run, not in the recipe.",
                "properties": {
                  "bands": {
                    "description": "Names of the bands to convert, each once; the others of the stock are left as they are.",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 256,
                    "minItems": 1,
                    "title": "Bands",
                    "type": "array"
                  },
                  "clip": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "linear, percentile: limit the result to the target range.",
                    "title": "Clip"
                  },
                  "high": {
                    "anyOf": [
                      {
                        "enum": [
                          95,
                          98,
                          99,
                          100
                        ],
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "percentile: percent that becomes out_max.",
                    "title": "High"
                  },
                  "in_max": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "linear: value that becomes out_max.",
                    "title": "In Max"
                  },
                  "in_min": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "linear: value that becomes out_min.",
                    "title": "In Min"
                  },
                  "low": {
                    "anyOf": [
                      {
                        "enum": [
                          0,
                          1,
                          2,
                          5
                        ],
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "percentile: percent that becomes out_min.",
                    "title": "Low"
                  },
                  "method": {
                    "description": "linear: a fixed range; percentile: two percentiles; zscore; robust: median and IQR.",
                    "enum": [
                      "linear",
                      "percentile",
                      "zscore",
                      "robust"
                    ],
                    "title": "Method",
                    "type": "string"
                  },
                  "out_max": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "linear, percentile: target range end; below out_min reverses.",
                    "title": "Out Max"
                  },
                  "out_min": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "linear, percentile: target range start.",
                    "title": "Out Min"
                  }
                },
                "required": [
                  "method",
                  "bands"
                ],
                "title": "NormalizeParamsV3",
                "type": "object"
              }
            },
            "required": [
              "op",
              "op_version",
              "params"
            ],
            "title": "Normalize",
            "type": "object",
            "x-earthx-kind": "pixel",
            "x-earthx-tiers": [
              "T2"
            ]
          },
          "step_reproject_v4": {
            "additionalProperties": false,
            "description": "Bring the raster into another CRS at a chosen pixel size, with a chosen resampling.",
            "properties": {
              "op": {
                "const": "reproject"
              },
              "op_version": {
                "const": 4
              },
              "params": {
                "additionalProperties": false,
                "description": "The panel's form (K8); names follow openEO ``resample_spatial``.",
                "properties": {
                  "align": {
                    "default": false,
                    "description": "Lay the pixel grid on whole multiples of the resolution in the target CRS, e.g. at 30 m, 60 m, 90 m for a resolution of 30 m. Results for different areas or dates then line up pixel by pixel. The result may reach up to one pixel further out on each side.",
                    "title": "Align",
                    "type": "boolean"
                  },
                  "crs": {
                    "description": "Target CRS as an EPSG code, e.g. EPSG:3035.",
                    "pattern": "^EPSG:[0-9]{4,6}$",
                    "title": "Crs",
                    "type": "string"
                  },
                  "resampling": {
                    "description": "No default: the choice changes the values. Anything but nearest and mode interpolates.",
                    "oneOf": [
                      {
                        "const": "nearest",
                        "description": "Value of the nearest source pixel; for class data and masks.",
                        "title": "nearest"
                      },
                      {
                        "const": "bilinear",
                        "description": "Distance-weighted mean of the 2x2 nearest pixels; for continuous data.",
                        "title": "bilinear"
                      },
                      {
                        "const": "cubic",
                        "description": "Cubic convolution over 4x4 pixels; sharper than bilinear, for continuous data.",
                        "title": "cubic"
                      },
                      {
                        "const": "cubicspline",
                        "description": "Cubic B-spline over 4x4 pixels; smoothest, for continuous data.",
                        "title": "cubicspline"
                      },
                      {
                        "const": "lanczos",
                        "description": "Lanczos windowed sinc over 6x6 pixels; sharpest, may overshoot at edges.",
                        "title": "lanczos"
                      },
                      {
                        "const": "average",
                        "description": "Mean of all source pixels per target pixel; for coarsening continuous data.",
                        "title": "average"
                      },
                      {
                        "const": "mode",
                        "description": "Most frequent source value per target pixel; for class data.",
                        "title": "mode"
                      }
                    ],
                    "title": "Resampling",
                    "type": "string"
                  },
                  "resolution": {
                    "description": "Pixel size in the units of the target CRS, square pixels.",
                    "exclusiveMinimum": 0,
                    "title": "Resolution",
                    "type": "number"
                  }
                },
                "required": [
                  "crs",
                  "resolution",
                  "resampling"
                ],
                "title": "ReprojectParams",
                "type": "object"
              }
            },
            "required": [
              "op",
              "op_version",
              "params"
            ],
            "title": "Reproject and resample",
            "type": "object",
            "x-earthx-kind": "grid",
            "x-earthx-tiers": [
              "T2"
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "The order (§4.1): what someone asks for, without any address.\n\n``aoi`` may be left out for a raster job: the order then asks for the whole scenes it\nnames, and `api` puts the union of their footprints into the recipe (M4-12); an export\nneeds the area it cuts out, which `api` checks. The recipe itself always carries an AOI,\nso the core and the hash do not change.",
        "properties": {
          "aoi": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "MultiPolygon": "#/$defs/MultiPolygon",
                    "Polygon": "#/$defs/Polygon"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/Polygon"
                  },
                  {
                    "$ref": "#/$defs/MultiPolygon"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The area to cut out, a Polygon or MultiPolygon in EPSG:4326. Left out, a raster job covers the whole scenes it names (the union of their footprints); an export needs it.",
            "title": "Aoi"
          },
          "inputs": {
            "items": {
              "$ref": "#/$defs/InputRequest"
            },
            "maxItems": 1,
            "minItems": 1,
            "title": "Inputs",
            "type": "array"
          },
          "output": {
            "$ref": "#/$defs/RasterOutput"
          },
          "recipe_version": {
            "title": "Recipe Version",
            "type": "integer"
          },
          "steps": {
            "items": {
              "discriminator": {
                "propertyName": "op"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/step_band_math_v2"
                },
                {
                  "$ref": "#/$defs/step_mask_v2"
                },
                {
                  "$ref": "#/$defs/step_mask_values_v1"
                },
                {
                  "$ref": "#/$defs/step_normalize_v4"
                },
                {
                  "$ref": "#/$defs/step_reproject_v4"
                }
              ]
            },
            "maxItems": 16,
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "recipe_version",
          "steps",
          "output",
          "inputs"
        ],
        "title": "RecipeRequest",
        "type": "object"
      },
      "title": "Order"
    }
  },
  "jobControlOptions": [
    "async-execute",
    "dismiss"
  ],
  "links": [
    {
      "href": "/processing/processes/recipe",
      "rel": "self",
      "title": "This document",
      "type": "application/json"
    },
    {
      "href": "/processing/processes/recipe/execution",
      "rel": "http://www.opengis.net/def/rel/ogc/1.0/execute",
      "title": "Place a job",
      "type": "application/json"
    }
  ],
  "outputTransmission": [
    "reference"
  ],
  "outputs": {
    "bundle": {
      "schema": {
        "contentMediaType": "application/zip",
        "type": "string"
      },
      "title": "Result, mask, area, recipe, citation and attribution in one ZIP"
    },
    "export": {
      "schema": {
        "contentMediaType": "application/zip",
        "type": "string"
      },
      "title": "Export: per group and asset the data and its mask, with notice, recipe and citation"
    },
    "mask": {
      "schema": {
        "contentMediaType": "image/tiff; application=geotiff",
        "type": "string"
      },
      "title": "Mask of the area of interest"
    },
    "methods": {
      "schema": {
        "contentMediaType": "text/plain",
        "type": "string"
      },
      "title": "The methods text of the recipe's provenance, as a paragraph for a methods section"
    },
    "recipe": {
      "schema": {
        "contentMediaType": "application/json",
        "type": "string"
      },
      "title": "The recipe the job ran, with its provenance and the methods text"
    },
    "result": {
      "schema": {
        "contentMediaType": "image/tiff; application=geotiff; profile=cloud-optimized",
        "type": "string"
      },
      "title": "Result raster (Cloud Optimized GeoTIFF)"
    },
    "tiles": {
      "schema": {
        "contentMediaType": "application/json",
        "type": "string"
      },
      "title": "The result as map tiles (TileJSON), served by the tiler"
    }
  },
  "title": "Recipe",
  "version": "2"
}
