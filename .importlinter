; Module boundaries from architekturplan.md 3.1, as import-linter contracts.
;
; STATUS: ENFORCED (M1-02). The target modules under `backend/earthx/` exist
; as empty packages; the `import-boundaries` job in .github/workflows/ci.yml
; runs `lint-imports` on every pull request.
;
; Each contract names what a module may NOT import. The allowed imports are the
; complement, i.e. exactly column 3 of the table in architekturplan.md 3.1.
; `backend/tests/test_module_boundaries.py` checks that this file stays in sync
; with that table.
;
; Run locally from the repo root: PYTHONPATH=backend lint-imports --config .importlinter
;
; M2-01 (ENTSCHEIDUNGSLOG 2026-09-20, "Importverträge zählen direkte Importe"):
; the nine module-boundary contracts below (gateway through identity) now set
; `allow_indirect_imports = True`, so only a *direct* import of a forbidden
; module is a violation. Column 3 of 3.1 allows chains such as
; `access -> readers -> gateway` and `processing -> catalog -> gateway`; with
; the default chain-counting behaviour those were indistinguishable from a
; direct `access -> gateway` import and could never be satisfied once
; `readers`/`catalog` gained content. `datasets-isolated` and
; `no-database-in-worker-core` keep counting chains: for KLAERUNGEN B9 the
; chain itself (e.g. `processing -> catalog -> psycopg`) is the violation.
; M4-06 (adr/0015 §4.2): `objectstore` is a tenth module-boundary contract of
; the same kind, and `no-object-store-in-worker-core` a third one that counts
; chains.

[importlinter]
root_package = earthx
include_external_packages = True

[importlinter:contract:gateway]
name = gateway imports nothing domain-specific
type = forbidden
allow_indirect_imports = True
source_modules =
    earthx.gateway
forbidden_modules =
    earthx.catalog
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets
    earthx.objectstore

[importlinter:contract:catalog]
name = catalog imports only gateway
type = forbidden
allow_indirect_imports = True
source_modules =
    earthx.catalog
forbidden_modules =
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets
    earthx.objectstore

[importlinter:contract:adapters]
name = adapters import only gateway and catalog
type = forbidden
allow_indirect_imports = True
source_modules =
    earthx.adapters
forbidden_modules =
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets
    earthx.objectstore

[importlinter:contract:readers]
name = readers import only gateway
type = forbidden
allow_indirect_imports = True
source_modules =
    earthx.readers
forbidden_modules =
    earthx.catalog
    earthx.adapters
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets
    earthx.objectstore

[importlinter:contract:access]
name = access imports only readers and catalog
type = forbidden
allow_indirect_imports = True
source_modules =
    earthx.access
forbidden_modules =
    earthx.gateway
    earthx.adapters
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets
    earthx.objectstore

[importlinter:contract:processing]
name = processing imports only access, readers and catalog
type = forbidden
allow_indirect_imports = True
source_modules =
    earthx.processing
forbidden_modules =
    earthx.gateway
    earthx.adapters
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets
    earthx.objectstore

[importlinter:contract:jobs]
name = jobs import only processing and objectstore
type = forbidden
allow_indirect_imports = True
source_modules =
    earthx.jobs
forbidden_modules =
    earthx.gateway
    earthx.catalog
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets

[importlinter:contract:discovery]
name = discovery imports only adapters, catalog and gateway
type = forbidden
allow_indirect_imports = True
source_modules =
    earthx.discovery
forbidden_modules =
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.identity
    earthx.api
    earthx.datasets
    earthx.objectstore

[importlinter:contract:identity]
name = identity imports nothing else
type = forbidden
allow_indirect_imports = True
source_modules =
    earthx.identity
forbidden_modules =
    earthx.gateway
    earthx.catalog
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.api
    earthx.datasets
    earthx.objectstore

[importlinter:contract:objectstore]
name = objectstore imports nothing domain-specific
type = forbidden
allow_indirect_imports = True
source_modules =
    earthx.objectstore
forbidden_modules =
    earthx.gateway
    earthx.catalog
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets

[importlinter:contract:datasets-isolated]
name = nothing generic imports a dataset module
type = forbidden
source_modules =
    earthx.gateway
    earthx.catalog
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.objectstore
forbidden_modules =
    earthx.datasets

[importlinter:contract:no-database-in-worker-core]
name = the worker core reaches no database (KLAERUNGEN B9)
type = forbidden
source_modules =
    earthx.jobs
    earthx.processing
forbidden_modules =
    psycopg

[importlinter:contract:no-object-store-in-worker-core]
name = the worker core reaches no object store (KLAERUNGEN B9, adr/0015 §4.2)
type = forbidden
; Its own contract, not a line in `no-database-in-worker-core` (M4 R2): `jobs` is
; a source there and may import `objectstore`. Counts chains, like that one: for
; B9 `processing -> ... -> earthx.objectstore` is the violation itself.
source_modules =
    earthx.processing
forbidden_modules =
    earthx.objectstore
    botocore

[importlinter:contract:http-only-in-gateway]
name = HTTP and S3 clients live only in gateway (KLAERUNGEN B8)
type = forbidden
; Direct imports only (Otto, 19.09.2026, M1-06). The rule is that no module
; outside `gateway` opens a connection itself; reaching a source *through*
; `gateway` is the architecture, not a breach of it. Counting indirect chains
; forbade exactly that: `gateway.policy` parses URLs with `urllib.parse`, so
; `adapters -> gateway -> urllib` was a violation, and with it every import of
; `gateway` by the modules 3.1 allows it for (catalog, adapters, readers,
; discovery). The direct rule stays checked twice: here, and over the syntax
; tree of every module in backend/tests/earthx/test_no_outbound_outside_gateway.py,
; which also sees an import hidden inside a function.
allow_indirect_imports = True
; Source modules are the eleven of 3.1 that are not `gateway` (with
; `objectstore` since M4-06), PLUS every module that lives directly in the
; package root. A root module is not one of the twelve, but it is still code that must not fetch — `test_module_boundaries.py`
; reads the root modules from disk, so a new one fails the suite until it is
; listed here.
source_modules =
    earthx.logging
    earthx.catalog
    earthx.adapters
    earthx.readers
    earthx.access
    earthx.processing
    earthx.jobs
    earthx.discovery
    earthx.identity
    earthx.api
    earthx.datasets
    earthx.objectstore
; `httpx2` and `obstore` joined the list in M2-04 (adr/0006 §5 "Zu Frage 6",
; Otto 20.09.2026): `rio-tiler` fetches STAC items over `httpx2`, and
; `titiler.xarray` would bring `obstore` with M2-09. Both are clients, so both
; belong here — a tightening, not a loosening. What this list cannot catch is
; `rio_tiler.io.stac` itself: import-linter refuses a subpackage of an external
; package as a forbidden module ("subpackages of external packages are not valid"),
; so that one is checked over the syntax tree in
; backend/tests/earthx/test_no_outbound_outside_gateway.py.
forbidden_modules =
    httpx
    httpx2
    requests
    urllib
    pystac_client
    aiohttp
    boto3
    obstore
    botocore
    urllib3
    s3transfer
    aiobotocore
    aioboto3
    minio
; M4-06 (adr/0015 F2, KLAERUNGEN B8 Nachtrag 2026-10-05): the platform's own
; object store is a platform service, not a way out. Its client is the one
; exception to this contract, and it is one import, not one module: any other
; module importing `botocore` — `earthx.objectstore` included — still breaks it.
; The endpoint comes only from the configuration (earthx/objectstore/config.py).
; `botocore` through `urllib3` and the other S3 clients joined the list with it.
ignore_imports =
    earthx.objectstore.client -> botocore
