# Placeholders for docker-compose.yml. Copy to `.env` and adjust locally;
# `.env` is git-ignored and never committed. CI sets its own throwaway
# values (.github/workflows/ci.yml) and does not read this file.
#
# No real secrets belong here or in `.env` for this compose topology — it
# only ever runs against local, disposable data (CLAUDE.md).

POSTGRES_USER=earthx
POSTGRES_PASSWORD=changeme
POSTGRES_DB=earthx

# Object store (Garage, M3-23/adr/0012). Leave empty: the objectstore-secrets
# service generates a key and bucket on the first `docker compose up` and
# reuses them on every later start. Set all three only to pin your own
# values (S3_ACCESS_KEY at least 8 characters, S3_SECRET_KEY at least 16).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
